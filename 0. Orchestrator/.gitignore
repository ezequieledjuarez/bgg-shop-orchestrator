# Orchestrator specific ignores
__pycache__/
*.py[cod]
.env
.env.*
.DS_Store
*.log

# Test diagnostics/artifacts
**/diagnostics/
**/diagnostics/*.json
**/diagnostics/*.txt
tests/**/diagnostics/
tests/**/*.json
tests/**/*.txt
tests/e2e/storageState.json
# Project-specific runtime artifacts
odd/*.txt
odd/*.json
odd/**/diagnostics/
# Insomnia exports and local test artifacts
insomnia/*.json
test-results/
# Ignore local frontend workspace changes
bgg-shop-frontend/
# Ignore pollList diagnostic files generated by e2e
tests/e2e/diagnostics/pollList_*.txt
