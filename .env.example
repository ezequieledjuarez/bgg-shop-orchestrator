SECRET_KEY=PLACEHOLDER_SECRET_KEY
DATABASE_URL=postgresql://PLACEHOLDER_USER:PLACEHOLDER_PASSWORD@localhost:5432/PLACEHOLDER_DB
MP_ACCESS_TOKEN=PLACEHOLDER_MP_ACCESS_TOKEN
MP_SANDBOX=false
MP_CURRENCY_ID=
COUNTRY_MONEY_CODE=AR
FRONTEND_URL=http://localhost:9999

# Shared Core/BFF service key, required for email confirmation and resend.
# Set the same random value in both services; use at least 32 bytes.
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave no real keys in this example file. Keep the generated value in .env only.
OPKEY_INTERNAL_SECRET=

# Email verification: local capture with Mailpit (no external delivery).
# Compose passes these variables to Core; recreate api after changing them.
# Mailpit inbox: http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=maildehost@mail.example.com
MEEPLE_APP_SMTP_PASSWORD=generatedpasswordfromgoogle
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_EXTERNAL_SMTP_ENABLED=false
DEFAULT_FROM_EMAIL=noreply@saleor.local

# Public frontend origin used in verification links (no trailing path).
# localhost links must be opened on the computer running the application.
EMAIL_VERIFICATION_FRONTEND_ORIGIN=http://localhost:9999

# Gmail alternative: REPLACE the SMTP values above; do not keep duplicate keys.
# The username and sender must be the Gmail account issuing the app password.
# The recipient is the registering user's address, not DEFAULT_FROM_EMAIL.
# Enable two-step verification and create a Google app password.
# Store its 16 characters without display spaces; never use your account password.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-account@gmail.com
# MEEPLE_APP_SMTP_PASSWORD=REPLACE_WITH_GOOGLE_APP_PASSWORD
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_EXTERNAL_SMTP_ENABLED=true
# DEFAULT_FROM_EMAIL=your-account@gmail.com
# TLS (587) and SSL (465) are alternatives; never enable both.
